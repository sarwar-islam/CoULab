# DLAS configuration example
#
# The repository ships with a seeded SQLite database and a hardcoded
# datasource URL in prisma/schema.prisma (file:./dev.db), so NO .env file is
# required to run the demo. If you prefer to drive the connection via the
# environment instead:
#
#   1. In prisma/schema.prisma set:  url = env("DATABASE_URL")
#   2. Copy this file to .env and adjust the path below.
#
# Path is resolved relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
